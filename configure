#!/bin/bash
# TocinOS Configuration Script
# Configures the build system and checks dependencies

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Default configuration
ARCH="x86"
DEBUG="n"
OPTIMIZE="n"
VERBOSE="n"
TESTS="n"
DOCS="n"
KASLR="y"
CFS="y"
ZSWAP="y"
TOCINFS="y"
SECURITY="y"

# Function to print colored output
print_ok() {
    echo -e "${GREEN}[OK]${NC} $1"
}

print_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

print_warn() {
    echo -e "${YELLOW}[WARN]${NC} $1"
}

print_info() {
    echo -e "[INFO] $1"
}

# Function to check if a command exists
check_command() {
    if command -v "$1" >/dev/null 2>&1; then
        print_ok "$1 found: $(command -v $1)"
        return 0
    else
        print_error "$1 not found"
        return 1
    fi
}

# Parse command line arguments
while [[ $# -gt 0 ]]; do
    case $1 in
        --arch=*)
            ARCH="${1#*=}"
            shift
            ;;
        --enable-debug)
            DEBUG="y"
            shift
            ;;
        --enable-optimize)
            OPTIMIZE="y"
            shift
            ;;
        --enable-verbose)
            VERBOSE="y"
            shift
            ;;
        --enable-tests)
            TESTS="y"
            shift
            ;;
        --enable-docs)
            DOCS="y"
            shift
            ;;
        --help)
            echo "TocinOS Configuration Script"
            echo ""
            echo "Usage: ./configure [options]"
            echo ""
            echo "Options:"
            echo "  --arch=ARCH           Set target architecture (x86 or x86_64)"
            echo "  --enable-debug        Enable debugging symbols"
            echo "  --enable-optimize     Enable compiler optimizations"
            echo "  --enable-verbose      Enable verbose build output"
            echo "  --enable-tests        Enable testing infrastructure"
            echo "  --enable-docs         Enable documentation generation"
            echo "  --help                Show this help message"
            echo ""
            echo "Examples:"
            echo "  ./configure"
            echo "  ./configure --arch=x86_64 --enable-debug"
            echo "  ./configure --enable-tests --enable-docs"
            exit 0
            ;;
        *)
            print_error "Unknown option: $1"
            echo "Run './configure --help' for usage information"
            exit 1
            ;;
    esac
done

echo "========================================"
echo "  TocinOS Configuration"
echo "========================================"
echo ""

# Check required dependencies
print_info "Checking required dependencies..."
DEPS_OK=true

if ! check_command "nasm"; then
    print_error "Please install nasm: sudo apt-get install nasm"
    DEPS_OK=false
fi

if ! check_command "gcc"; then
    print_error "Please install gcc: sudo apt-get install build-essential"
    DEPS_OK=false
fi

if ! check_command "ld"; then
    print_error "Please install binutils: sudo apt-get install binutils"
    DEPS_OK=false
fi

if ! check_command "objcopy"; then
    print_error "Please install binutils: sudo apt-get install binutils"
    DEPS_OK=false
fi

if ! check_command "make"; then
    print_error "Please install make: sudo apt-get install make"
    DEPS_OK=false
fi

echo ""

# Check optional dependencies
print_info "Checking optional dependencies..."

if check_command "qemu-system-i386"; then
    print_ok "QEMU (32-bit) available for testing"
else
    print_warn "QEMU not found - install for testing: sudo apt-get install qemu-system-x86"
fi

if check_command "qemu-system-x86_64"; then
    print_ok "QEMU (64-bit) available for testing"
fi

if [ "$DOCS" = "y" ]; then
    if check_command "doxygen"; then
        print_ok "Doxygen available for documentation"
    else
        print_warn "Doxygen not found - install: sudo apt-get install doxygen graphviz"
    fi
fi

echo ""

if [ "$DEPS_OK" = false ]; then
    print_error "Required dependencies missing. Please install them and run configure again."
    exit 1
fi

# Validate architecture
if [ "$ARCH" != "x86" ] && [ "$ARCH" != "x86_64" ]; then
    print_error "Invalid architecture: $ARCH (must be x86 or x86_64)"
    exit 1
fi

# Create .config file
print_info "Generating .config file..."

cat > .config << EOF
# TocinOS Build Configuration
# Generated by ./configure on $(date)

# Target architecture
CONFIG_ARCH=$ARCH

# Build options
CONFIG_DEBUG=$DEBUG
CONFIG_OPTIMIZE=$OPTIMIZE
CONFIG_VERBOSE=$VERBOSE

# Features
CONFIG_TESTS=$TESTS
CONFIG_DOCS=$DOCS

# Advanced features
CONFIG_KASLR=$KASLR
CONFIG_CFS_SCHEDULER=$CFS
CONFIG_ZSWAP=$ZSWAP
CONFIG_TOCINFS=$TOCINFS
CONFIG_SECURITY=$SECURITY
EOF

print_ok ".config file created"
echo ""

# Display configuration summary
echo "========================================"
echo "  Configuration Summary"
echo "========================================"
echo "Architecture:      $ARCH"
echo "Debug symbols:     $DEBUG"
echo "Optimization:      $OPTIMIZE"
echo "Verbose build:     $VERBOSE"
echo "Testing:           $TESTS"
echo "Documentation:     $DOCS"
echo ""
echo "Advanced Features:"
echo "  KASLR:           $KASLR"
echo "  CFS Scheduler:   $CFS"
echo "  zswap:           $ZSWAP"
echo "  TocinFS:         $TOCINFS"
echo "  Security:        $SECURITY"
echo "========================================"
echo ""

print_ok "Configuration complete!"
echo ""
echo "Next steps:"
echo "  1. Build the OS:    make"
echo "  2. Run in QEMU:     make run"
if [ "$TESTS" = "y" ]; then
    echo "  3. Run tests:       make test"
fi
if [ "$DOCS" = "y" ]; then
    echo "  4. Generate docs:   make docs"
fi
echo ""
